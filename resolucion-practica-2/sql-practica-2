--6
DESCRIBE workspace.bigdata_santiago.gold_batch_summary;

SELECT source_batch_id AS Lote, rejected_transactions/(accepted_transactions+rejected_transactions) AS Tasa_de_rechazo
FROM workspace.bigdata_santiago.gold_batch_summary
ORDER BY Tasa_de_rechazo;


--7
DESCRIBE workspace.bigdata_santiago.gold_daily_sales;

SELECT sale_date AS Dia_de_mayor_monto_total, total_amount AS Monto_total, transaction_count AS Cantidad_de_transacciones
FROM workspace.bigdata_santiago.gold_daily_sales
ORDER BY total_amount DESC
LIMIT 1;

SELECT sale_date AS Dia_de_mas_transacciones, total_amount AS Monto_total, transaction_count AS Cantidad_de_transacciones
FROM workspace.bigdata_santiago.gold_daily_sales
ORDER BY transaction_count DESC
LIMIT 1;


--8
SELECT payment_channel AS Canal_de_pago, SUM(fraud_transactions)/SUM(transaction_count) AS Tasa_de_fraude
FROM workspace.bigdata_santiago.gold_daily_sales
GROUP BY payment_channel
ORDER BY Tasa_de_fraude DESC
LIMIT 1;

SELECT payment_channel, fraud_rate
FROM workspace.bigdata_santiago.gold_daily_sales
ORDER BY fraud_rate ASC
LIMIT 20;


--9
SELECT country AS Pais, category AS Categoria, SUM(total_amount) as Monto
FROM workspace.bigdata_santiago.gold_daily_sales
GROUP BY country, category
ORDER BY Monto DESC
LIMIT 1;

WITH aux AS (
    SELECT country, category, SUM(total_amount) AS Monto,
    ROW_NUMBER() OVER (PARTITION BY country ORDER BY SUM(total_amount) DESC) AS rn
    FROM workspace.bigdata_santiago.gold_daily_sales
    GROUP BY country, category
)
SELECT country AS Pais, category AS Categoria, Monto 
FROM aux
WHERE rn = 1;


