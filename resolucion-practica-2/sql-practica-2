--2
DESCRIBE workspace.bigdata_santiago.silver_transactions;

SELECT
    source_batch_id as Lote,
    COUNT(CASE WHEN estado = 'Aceptada' THEN 1 END) AS Aceptadas,
    COUNT(CASE WHEN estado = 'Rechazada' THEN 1 END) AS Rechazadas,
    COUNT(*) AS Total
FROM (
    SELECT source_batch_id, 'Aceptada' AS estado FROM workspace.bigdata_santiago.silver_transactions
    UNION ALL
    SELECT source_batch_id, 'Rechazada' AS estado FROM workspace.bigdata_santiago.silver_transactions_quarantine
)
GROUP BY source_batch_id
ORDER BY source_batch_id;

DESCRIBE workspace.bigdata_santiago.gold_batch_summary;

SELECT source_batch_id as Lote, accepted_transactions as Aceptadas, rejected_transactions as Rechazadas, 
accepted_transactions + rejected_transactions as Total
FROM workspace.bigdata_santiago.gold_batch_summary
ORDER BY source_batch_id;

SELECT * FROM workspace.bigdata_santiago.gold_batch_summary;



--3
DESCRIBE workspace.bigdata_santiago.silver_transactions_quarantine;

SELECT source_batch_id AS Lote, quality_reason AS Motivo, COUNT(*) AS cantidad
FROM workspace.bigdata_santiago.silver_transactions_quarantine
WHERE quality_reason IS NOT NULL
GROUP BY source_batch_id, quality_reason
ORDER BY source_batch_id;


